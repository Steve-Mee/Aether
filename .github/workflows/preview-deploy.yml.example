# Optional PR preview deployment for the AETHER admin frontend.
#
# Setup:
#   1. Copy this file to preview-deploy.yml (remove .example)
#   2. Create a Vercel project with root directory aether-core/frontend
#   3. Add GitHub secrets: VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
#
# Alternative: use Vercel's native GitHub integration (no workflow needed).

name: Preview Deploy

on:
  pull_request:
    branches: [main, develop]
    paths:
      - 'aether-core/frontend/**'

jobs:
  deploy-preview:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: aether-core/frontend

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm
          cache-dependency-path: aether-core/frontend/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npm run build
        env:
          VITE_API_URL: https://api.staging.example.com
          VITE_AETHER_API_KEY: preview-build-key
          VITE_AETHER_TENANT: tenant_default

      - name: Deploy to Vercel Preview
        uses: amondnet/vercel-action@v25
        with:
          vercel-token: ${{ secrets.VERCEL_TOKEN }}
          vercel-org-id: ${{ secrets.VERCEL_ORG_ID }}
          vercel-project-id: ${{ secrets.VERCEL_PROJECT_ID }}
          working-directory: aether-core/frontend
          scope: ${{ secrets.VERCEL_ORG_ID }}
