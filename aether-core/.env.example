# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aether_core?schema=public"

# Server
PORT=9000
NODE_ENV=development

# AI / LLM (Ollama local)
OLLAMA_BASE_URL=http://localhost:11434
# Dockerized backend can use host machine Ollama through this value
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434

# Frontend
VITE_API_URL=http://localhost:9000

# Docker Postgres (optional overrides for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aether_core

# Future: Add API keys here when needed
# OPENAI_API_KEY=sk-...
# STRIPE_SECRET_KEY=sk_...