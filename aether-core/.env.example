# Database — Docker Compose exposes Postgres on host port 15432 (see docker-compose.yml).
# Use 5432 only if you run Postgres directly on localhost without Docker.
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/aether_core?schema=public"

# Server
PORT=9000
NODE_ENV=development

# Auth — run `npm run setup:env` in backend/ to generate secure values
AETHER_API_KEY=
AETHER_DEFAULT_TENANT=tenant_default
# JWT merchant login (required when VITE_AUTH_PROVIDER=jwt)
AETHER_JWT_SECRET=
AETHER_JWT_EXPIRES_IN=15m
AETHER_REFRESH_EXPIRES_IN=7d
AETHER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AETHER_SEED_USER_PASSWORD=AetherDev2026!

# AI / LLM (Ollama local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434

# IMAP TLS cert verification (set false only for local dev with self-signed certs)
IMAP_TLS_REJECT_UNAUTHORIZED=true

# Hive mind anonymization salt — generated by setup:env
HIVE_MIND_SALT=

# IMAP (optional — enables automatic email ingestion when set)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_POLL_INTERVAL_MS=60000

# Supplier demo seed (backend): 8 demo suppliers + sample changes
SEED_SUPPLIER_DEMO=false

# Supplier scraping allowlist (comma-separated domains)
SUPPLIER_ALLOWLIST=

# Supplier scraper: http | playwright (playwright requires npx playwright install)
SUPPLIER_SCRAPER=http

# Rate limiting
RATE_LIMIT_MAX=120

# Frontend — Vite reads env from this directory (aether-core/), not frontend/
# Copy this file to .env and fill in secrets (API keys). See frontend/docs/API_INTEGRATION.md.
# Committed mode templates: .env.development | .env.staging | .env.production

# API base URL — leave empty in dev to use Vite proxy (/api → localhost:9000)
VITE_API_URL=
# Alias for VITE_API_URL (takes precedence when both are set; use for staging/production)
# VITE_API_BASE_URL=https://api.example.com

# Data source — mock (offline) or live (real API). VITE_USE_MOCK overrides VITE_DATA_SOURCE.
VITE_DATA_SOURCE=live
# VITE_USE_MOCK=true

# VITE_AETHER_API_KEY must match AETHER_API_KEY (required in production builds)
VITE_AETHER_API_KEY=
VITE_AETHER_TENANT=tenant_default

# Demo layers (disable for staging/production backend integration)
# Hybrid: pad thin API responses with demo data in live mode (default: true in dev)
VITE_HYBRID_DEMO=true
# Force demo suppliers UI when API is empty
VITE_SUPPLIERS_DEMO=false
# Live demo: simulated notifications/events every ~12–18s (opt-in; default off when unset)
# VITE_LIVE_DEMO=true

# Merchant name shown in global app shell top bar
VITE_MERCHANT_DISPLAY_NAME=

# Auth — stub demo login (default); set jwt for Argon2 + refresh-cookie backend login
# VITE_AUTH_PROVIDER=stub|jwt
# VITE_AUTH_AUTO_LOGIN=true

# Client logging (debug|info|warn|error)
VITE_LOG_LEVEL=info

# Error monitoring (staging/production — leave DSN empty in development)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENV=staging
# VITE_APP_VERSION=0.8.1
# VITE_SENTRY_DEV=true              # Optional: enable Sentry in local dev

# CI / deploy sourcemap upload (not exposed to browser)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Backend Sentry (same project or separate — staging/production)
# SENTRY_DSN=
# SENTRY_ENV=staging
# SENTRY_DEV=false
# APP_VERSION=0.8.1

# Docker Postgres (host port 5433 — avoids Windows native Postgres on 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aether_core
POSTGRES_HOST_PORT=15432
