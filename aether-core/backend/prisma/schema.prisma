generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users     User[]
  apiKeys   ApiKey[]
  settings  TenantSettings?
}

model TenantSettings {
  tenantId                  String   @id
  autonomyLevel             String   @default("medium")
  autoApproveLowRisk        Boolean  @default(true)
  autoApproveMediumRiskMail  Boolean  @default(false)
  maxAutoPriceChangePct     Float    @default(5)
  maxMarginImpactEuro       Float    @default(500)
  policyEnabled             Boolean  @default(true)
  autoRunWindow             String   @default("always")
  autoRunWindowStart        String?  @default("18:00")
  autoRunWindowEnd          String?  @default("08:00")
  notificationPrefs         Json     @default("{}")
  locale                    String   @default("nl")
  dataExportEnabled         Boolean  @default(true)
  brainVectorBackend        String?
  brainKnowledgeTransferEnabled Boolean?
  brainKnowledgeUpdateProfile   String   @default("balanced")
  brainFederatedContributionEnabled Boolean @default(false)
  brainKnowledgeGovernanceMode  String   @default("full_loop")
  brainLoRAPath             String?
  brainActionMode           String   @default("confirm_on_uncertain")
  brainAdaptiveLearningEnabled Boolean @default(false)
  brainAdaptiveAutoExecuteEnabled Boolean @default(false)
  brainCrossTenantAgentPatternsEnabled Boolean @default(false)
  brainExplainabilityFederateEnabled   Boolean @default(false)
  brainFederatedExecutionContribute Boolean @default(false)
  brainBilateralExchangeEnabled Boolean @default(false)
  proactivePrefs            Json     @default("{}")
  explainabilityPrefs       Json     @default("{}")
  goalPrefs                 Json     @default("{}")
  overviewPrefs             Json     @default("{}")
  autonomyPrefs             Json     @default("{}")
  updatedAt                 DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AgentExplainabilitySnapshot {
  id            String    @id @default(cuid())
  tenantId      String
  sourceType    String
  sourceId      String
  rootRunId     String?
  detailLevel   String
  summary       String
  summarySource String    @default("template")
  llmSummaryAt  DateTime?
  agentKeys     String[]  @default([])
  intentId      String?
  triggerId     String?
  flowGraph     Json?
  payload       Json
  createdAt     DateTime  @default(now())

  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, rootRunId])
  @@index([tenantId, createdAt])
  @@index([tenantId, intentId])
  @@index([tenantId, triggerId])
}

model ExplainabilityPatternContribution {
  id          String   @id @default(cuid())
  tenantId    String
  patternKey  String
  sampleCount Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, patternKey])
  @@index([patternKey])
}

model GlobalExplainabilityPattern {
  id              String   @id @default(cuid())
  patternKey      String   @unique
  agentKeys       String[]
  triggerId       String?
  intentId        String?
  sourceType      String
  summaryTemplate String
  tenantCount     Int      @default(0)
  sampleSize      Int      @default(0)
  kAnonymityMet   Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([triggerId])
  @@index([sourceType])
}

model ProactiveSuggestion {
  id            String    @id @default(cuid())
  tenantId      String
  triggerId     String
  dedupeKey     String
  agentKey      String?
  goalId        String?
  title         String
  summary       String?
  command       String
  intentId      String
  category      String
  riskLevel     String
  executionMode String
  status        String    @default("active")
  snoozedUntil  DateTime?
  evidence      Json      @default("{}")
  priority      Int       @default(5)
  expiresAt     DateTime?
  clusterKey    String?
  enrichedAt    DateTime?
  enrichmentSource String?
  detectionRunId String?
  orchestrationSource String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  goal MerchantGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, priority])
  @@index([tenantId, clusterKey, status])
  @@index([tenantId, goalId, status])
}

model MerchantGoal {
  id            String    @id @default(cuid())
  tenantId      String
  title         String
  description   String?
  metricType    String
  metricScope   Json      @default("{}")
  targetValue   Float
  baselineValue Float
  currentValue  Float?
  unit          String
  direction     String
  deadline      DateTime
  status        String    @default("active")
  pursuitMode   String    @default("balanced")
  parentGoalId  String?
  priorityWeight Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  parent       MerchantGoal?          @relation("GoalHierarchy", fields: [parentGoalId], references: [id])
  children     MerchantGoal[]         @relation("GoalHierarchy")
  snapshots    GoalProgressSnapshot[]
  suggestions  ProactiveSuggestion[]

  @@index([tenantId, status])
  @@index([tenantId, deadline])
}

model GoalSuggestion {
  id                String   @id @default(cuid())
  tenantId          String
  dedupeKey         String
  title             String
  metricType        String
  metricScope       Json     @default("{}")
  suggestedTarget   Float
  suggestedBaseline Float
  suggestedDeadline DateTime
  confidence        Float
  rationale         String
  evidence          Json     @default("{}")
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status])
}

model GlobalGoalPattern {
  id                String   @id @default(cuid())
  patternKey        String   @unique
  metricType        String
  pursuitMode       String?
  completionRate    Float
  avgDaysToComplete Float?
  driftRecoveryRate Float?
  tenantCount       Int      @default(0)
  sampleSize        Int      @default(0)
  kAnonymityMet     Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model GoalPatternContribution {
  id          String @id @default(cuid())
  tenantId    String
  patternKey  String
  sampleCount Int    @default(1)

  @@unique([tenantId, patternKey])
}

model GoalProgressSnapshot {
  id          String   @id @default(cuid())
  goalId      String
  tenantId    String
  value       Float
  progressPct Float
  recordedAt  DateTime @default(now())
  source      String   @default("periodic")

  goal MerchantGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, recordedAt])
}

model User {
  id           String         @id @default(cuid())
  tenantId     String
  email        String
  role         String         @default("operator")
  passwordHash String?
  createdAt    DateTime       @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationInboxState {
  id             String    @id @default(cuid())
  tenantId       String
  actorId        String
  notificationId String
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([tenantId, actorId, notificationId])
  @@index([tenantId, actorId])
}

model MerchantNotification {
  id          String    @id
  tenantId    String
  kind        String
  category    String
  title       String
  body        String
  severity    String
  href        String?
  actionLabel String?
  sourceType  String
  sourceId    String    @default("")
  groupKey    String?
  groupCount  Int       @default(1)
  visible     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime?

  @@unique([tenantId, sourceType, sourceId, kind])
  @@index([tenantId, createdAt])
  @@index([tenantId, groupKey, createdAt])
  @@index([tenantId, visible, createdAt])
}

model NotificationDigestState {
  tenantId         String   @id
  lastSentAt       DateTime?
  lastWindowStart  DateTime?
  updatedAt        DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId, actorId])
}

model ApiKey {
  id        String   @id @default(cuid())
  tenantId  String
  keyHash   String   @unique
  label     String?
  role      String   @default("operator")
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())

  orders    Order[]

  @@unique([tenantId, email])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  slug        String
  price       Float    @default(0)
  stock       Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants    ProductVariant[]

  @@unique([tenantId, slug])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  price     Float
  currency  String  @default("EUR")
  stock     Int     @default(0)

  product   Product @relation(fields: [productId], references: [id])
}

model Order {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  status     String   @default("pending")
  total      Float
  currency   String   @default("EUR")
  createdAt  DateTime @default(now())

  customer   Customer   @relation(fields: [customerId], references: [id])
  items      OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order     Order @relation(fields: [orderId], references: [id])
}

model EmailMessage {
  id          String   @id @default(cuid())
  tenantId    String
  messageId   String?
  from        String
  subject     String?
  body        String?
  status      String   @default("received")
  riskLevel   String?
  category    String?
  confidence  Float?
  draftReply  String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@unique([tenantId, messageId])
}

model Mailbox {
  id             String    @id @default(cuid())
  tenantId       String
  email          String
  imapHost       String?
  smtpHost       String?
  credentialsEnc String?
  pollingPolicy  String    @default("default")
  lastPolledAt   DateTime?
  createdAt      DateTime  @default(now())

  @@unique([tenantId, email])
}

model Supplier {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  website         String
  status          String   @default("active")
  autoSyncEnabled Boolean  @default(true)
  supplierType    String?
  createdAt       DateTime @default(now())

  products  SupplierProduct[]
}

model SupplierProduct {
  id           String   @id @default(cuid())
  supplierId   String
  name         String
  sku          String
  currentPrice Float
  stock        Int
  lastUpdated  DateTime @default(now())

  supplier     Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, sku])
}

model SupplierChange {
  id         String   @id @default(cuid())
  tenantId   String
  supplierId String
  changeType String
  payload    String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

model Decision {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  result    String
  rationale String?
  actor     String?
  createdAt DateTime @default(now())
}

model Command {
  id              String    @id @default(cuid())
  tenantId        String
  command         String
  intent          String?
  result          String?
  confidence      Float?
  actor           String?
  undoable        Boolean   @default(false)
  revertedAt      DateTime?
  undoExpiresAt   DateTime?
  brainMemoryId   String?
  operationalMeta String?
  createdAt       DateTime  @default(now())
}

model BrainToolProposal {
  id         String   @id @default(cuid())
  tenantId   String
  commandId  String?
  approvalId String?
  tool       String
  payload    String
  summary    String
  risk       String
  status     String   @default("pending")
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([tenantId, status])
  @@index([commandId])
  @@index([approvalId])
}

model BrainAgentRun {
  id                 String   @id @default(cuid())
  tenantId           String
  commandId          String?
  transcript         String   @default("[]")
  status             String   @default("running")
  currentStep        Int      @default(0)
  totalSteps         Int      @default(0)
  pendingApprovalId  String?
  pendingProposalId  String?
  resumeContext      String?
  agentKey           String   @default("admin")
  parentRunId        String?
  delegationId       String?
  delegationMeta     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId, commandId])
  @@index([tenantId, pendingApprovalId])
  @@index([tenantId, parentRunId])
  @@index([tenantId, delegationId])
}

/// Run-scoped working memory (blackboard) shared across agents in a command run.
model RunWorkingMemory {
  id                String    @id @default(cuid())
  tenantId          String
  runId             String
  namespace         String
  key               String
  value             Json
  version           Int       @default(0)
  updatedByAgentKey String
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, runId, namespace, key])
  @@index([tenantId, runId])
  @@index([expiresAt])
}

/// Merchant-scoped shared memory (persists across command runs).
model MerchantSharedMemory {
  id                String    @id @default(cuid())
  tenantId          String
  namespace         String
  key               String
  value             Json
  version           Int       @default(0)
  updatedByAgentKey String
  promotedFromRunId String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, namespace, key])
  @@index([tenantId])
  @@index([expiresAt])
}

/// Async peer delegation job queue (fire-and-forget agent handoffs).
model AgentPeerJob {
  id              String    @id @default(cuid())
  tenantId        String
  parentRunId     String?
  sourceAgentKey  String
  targetAgentKey  String
  intent          String
  query           String
  status          String    @default("pending")
  resultPayload   String?
  error           String?
  idempotencyKey  String?   @unique
  actorId         String?
  jobMode         String    @default("handoff")
  messageType     String?
  contextPayload  Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  @@index([tenantId, status])
  @@index([tenantId, parentRunId])
}

/// Audit log for federated sandbox execution (no raw cross-tenant payloads).
model FederatedExecutionAudit {
  id                   String   @id @default(cuid())
  tenantId             String
  requestId            String   @unique
  sourceAgentKey       String
  capability           String
  summaryHash          String
  summary              String
  sourceDeploymentId   String?
  targetDeploymentId   String?
  remoteExecutionRef   String?
  responseLatencyMs    Int?
  queryHintHash        String?
  createdAt            DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Tracks distinct tenants contributing to a global agent pattern (k-anonymity).
model AgentPatternTenantContribution {
  id          String   @id @default(cuid())
  tenantId    String
  category    String
  agentKey    String
  patternType String
  createdAt   DateTime @default(now())

  @@unique([tenantId, category, agentKey, patternType])
  @@index([category, agentKey, patternType])
}

/// Governed bilateral data exchange contract between two tenants.
model BilateralExchangeContract {
  id                 String    @id @default(cuid())
  providerTenantId   String
  consumerTenantId   String
  status             String    @default("draft")
  schemaId           String
  allowedFields      Json      @default("[]")
  ttlExpiresAt       DateTime?
  consentProviderAt  DateTime?
  consentConsumerAt  DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  schema   BilateralExchangeSchema @relation(fields: [schemaId], references: [id])
  packages BilateralExchangePackage[]
  audits   BilateralExchangeAudit[]

  @@index([providerTenantId, status])
  @@index([consumerTenantId, status])
}

/// Platform-defined bilateral exchange schema templates.
model BilateralExchangeSchema {
  id          String   @id @default(cuid())
  schemaKey   String   @unique
  fields      Json     @default("[]")
  description String
  createdAt   DateTime @default(now())

  contracts BilateralExchangeContract[]
}

/// Audit log for bilateral exchange (no raw payloads).
model BilateralExchangeAudit {
  id          String   @id @default(cuid())
  contractId  String
  action      String
  fieldHash   String?
  recordCount Int?
  actorTenantId String?
  createdAt   DateTime @default(now())

  contract BilateralExchangeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
}

/// Immutable bilateral export package snapshot.
model BilateralExchangePackage {
  id          String    @id @default(cuid())
  contractId  String
  payloadJson Json
  packageHash String
  expiresAt   DateTime
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  contract BilateralExchangeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
}

/// Registry of remote federated deployments (v2 RPC).
model FederatedDeploymentRegistry {
  id            String   @id @default(cuid())
  deploymentId  String   @unique
  baseUrl       String?
  publicKey     String?
  capabilities  Json     @default("[]")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Cross-agent reflection handoff audit log.
model ReflectionHandoffLog {
  id              String   @id @default(cuid())
  tenantId        String
  sourceAgentKey  String
  targetAgentKey  String
  reflectionIds   Json
  summary         String
  delegationId    String?
  parentRunId     String?
  childRunId      String?
  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, sourceAgentKey])
}

/// Materialized unified overview feed row (v3 exact pagination + SSE replay).
model OverviewFeedEvent {
  id             String   @id @default(cuid())
  tenantId       String
  kind           String
  itemId         String
  at             DateTime
  eventType      String
  visible        Boolean  @default(true)
  payload        Json
  sourceType     String
  sourceId       String
  idempotencyKey String   @unique
  module         String?
  riskLevel      String?
  executionMode  String?
  agentKeys      String[] @default([])
  searchText     String?
  emailDispatchedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, visible, at(sort: Desc), kind, itemId])
  @@index([tenantId, emailDispatchedAt, createdAt])
}

/// A/B experiment for reflection quality / trigger config.
model ReflectionExperiment {
  id             String    @id @default(cuid())
  name           String
  status         String    @default("running")
  bucketMin      Int       @default(0)
  bucketMax      Int       @default(49)
  variantConfig  Json
  startAt        DateTime  @default(now())
  endAt          DateTime?
  createdAt      DateTime  @default(now())

  outcomes ReflectionExperimentOutcome[]
}

model ReflectionExperimentOutcome {
  id           String   @id @default(cuid())
  experimentId String
  tenantId     String
  runId        String?
  metric       String
  value        Float
  variantArm   String
  recordedAt   DateTime @default(now())

  experiment ReflectionExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, tenantId])
  @@index([experimentId, metric])
}

model Approval {
  id          String   @id @default(cuid())
  tenantId    String
  module      String
  actionType  String
  payload     String
  status      String   @default("pending")
  requestedBy String?
  resolvedBy  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  module    String
  action    String
  actor     String?
  details   String?
  createdAt DateTime @default(now())
}

model DomainEvent {
  id              String    @id @default(cuid())
  tenantId        String
  type            String
  payload         String
  idempotencyKey  String?   @unique
  processedAt     DateTime?
  relayedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([relayedAt, processedAt])
}

model OutcomeRecord {
  id                 String   @id @default(cuid())
  tenantId           String
  metric             String
  baseline           Float
  observed           Float
  uplift             Float
  confidence         Float
  verificationStatus String   @default("proposed")
  periodStart        DateTime
  periodEnd          DateTime
  goalId             String?
  sourceType         String?
  sourceId           String?
  rootRunId          String?
  createdAt          DateTime @default(now())

  @@index([tenantId, goalId])
}

model WorkflowRun {
  id        String   @id @default(cuid())
  tenantId  String
  workflow  String
  status    String   @default("running")
  createdAt DateTime @default(now())
  steps     WorkflowStep[]
}

model WorkflowStep {
  id        String   @id @default(cuid())
  runId     String
  name      String
  status    String
  input     String?
  output    String?
  createdAt DateTime @default(now())
  run       WorkflowRun @relation(fields: [runId], references: [id])
}

model PrivacyBudget {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  spent     Float    @default(0)
  budgetLimit Float  @default(100)
  updatedAt DateTime @updatedAt
}

model TenantFeature {
  id        String   @id @default(cuid())
  tenantId  String
  feature   String
  enabled   Boolean  @default(false)

  @@unique([tenantId, feature])
}

model PaymentIdempotency {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  paymentId String?
  createdAt DateTime @default(now())

  @@unique([tenantId, key])
}

model RevenueDistribution {
  id         String   @id @default(cuid())
  tenantId   String
  merchantId String
  amount     Float
  period     String
  createdAt  DateTime @default(now())
}

model InventoryItem {
  id          String @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String @default("default")
  quantity    Int    @default(0)

  @@unique([tenantId, productId, warehouseId])
}

model SupplierWebhookEvent {
  id         String   @id @default(cuid())
  tenantId   String
  supplierId String?
  payload    String
  status     String   @default("received")
  createdAt  DateTime @default(now())
}

model Forecast {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  prediction String
  confidence Float
  createdAt  DateTime @default(now())
}

model Payment {
  id            String   @id @default(cuid())
  tenantId      String
  orderId       String
  amount        Float
  status        String   @default("pending")
  paymentMethod String?
  transactionId String?
  createdAt     DateTime @default(now())
}

model Fulfillment {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Plugin {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  version   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
}

model Insight {
  id         String   @id @default(cuid())
  tenantId   String
  type       String
  content    String
  merchantId String?
  createdAt  DateTime @default(now())
}

model PhysicalLocation {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  type      String
  address   String?
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model MerchantShare {
  id          String   @id @default(cuid())
  tenantId    String
  merchantId  String
  percentage  Float
  createdAt   DateTime @default(now())
}

model Negotiation {
  id              String   @id @default(cuid())
  tenantId        String
  customerAgentId String
  merchantAgentId String
  productId       String?
  status          String   @default("active")
  currentOffer    Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  offers          Offer[]
}

model Agent {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  name      String
  createdAt DateTime @default(now())
}

model Offer {
  id            String   @id @default(cuid())
  negotiationId String
  agentId       String?
  price         Float
  conditions    String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])
}

model ImprovementProposal {
  id            String   @id @default(cuid())
  tenantId      String
  module        String
  type          String
  description   String
  confidence    Float
  status        String   @default("proposed")
  appliedConfig Json?
  createdAt     DateTime @default(now())
}

model NegotiationMetrics {
  tenantId  String   @id
  accept    Int      @default(0)
  counter   Int      @default(0)
  reject    Int      @default(0)
  llmUsed   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model BillingRecord {
  id              String    @id @default(cuid())
  tenantId        String
  outcomeId       String
  amount          Float
  currency        String    @default("EUR")
  status          String    @default("pending")
  stripeInvoiceId String?
  reconciledAt    DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId, outcomeId])
}

model MarketplaceListing {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  price     Float
  sellerId  String
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model Experiment {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  metric    String
  status    String   @default("active")
  createdAt DateTime @default(now())

  @@index([tenantId, metric])
}

model ExperimentAssignment {
  id         String   @id @default(cuid())
  tenantId   String
  metric     String
  treatedIds String
  controlIds String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([tenantId, metric])
}

/// Per-tenant semantic memory for the Intelligence Layer (embedding via pgvector migration).
model BrainMemory {
  id        String   @id @default(cuid())
  tenantId  String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/// Per-tenant agent session state for PersonalBrain.
model BrainAgentState {
  id         String   @id @default(cuid())
  tenantId   String
  sessionKey String   @default("default")
  state      Json
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, sessionKey])
}

/// Per-tenant LoRA adapter registry (metadata-only in v1).
model BrainLoRAAdapter {
  id          String   @id @default(cuid())
  tenantId    String
  adapterId   String
  version     String   @default("0.0.0")
  storagePath String
  traits      Json     @default("[]")
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, adapterId])
  @@index([tenantId])
}

/// Ops-managed global knowledge patches (v2+).
model GlobalKnowledgePatch {
  id          String    @id @default(cuid())
  patchKey    String    @unique
  version     String    @default("1.0.0")
  kind        String
  category    String
  title       String
  content     String
  priority    Int       @default(5)
  minProfile  String    @default("balanced")
  tags        Json      @default("[]")
  payload     Json?
  status      String    @default("draft")
  publishedAt DateTime?
  retiredAt   DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([category])
}

/// Audit log for outbound knowledge contributions (metadata only, no raw values).
model BrainKnowledgeContributionLog {
  id           String   @id @default(cuid())
  tenantId     String
  source       String
  category     String
  metric       String
  metricFingerprint String?
  sampleSize   Int      @default(1)
  submitted    Boolean
  rejectReason String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Tracks distilled pattern occurrences per tenant for auto-promote governance.
model DistilledPatternOccurrence {
  id              String   @id @default(cuid())
  tenantId        String
  patternHash     String
  intent          String
  occurrenceCount Int      @default(1)
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, patternHash])
  @@index([tenantId])
}

/// Secure aggregation round for cross-tenant metric federation.
model SecAggRound {
  id               String   @id @default(cuid())
  category         String
  metric           String
  status           String   @default("collecting")
  minTenants       Int      @default(5)
  participantCount Int      @default(0)
  deadlineAt       DateTime
  noiseEpsilon     Float    @default(1.0)
  aggregateValue   Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  participants SecAggParticipant[]
  updates      SecAggMaskedUpdate[]

  @@index([category, metric, status])
}

model SecAggParticipant {
  id         String   @id @default(cuid())
  roundId    String
  tenantId   String
  secretSeed String
  status     String   @default("active")
  createdAt  DateTime @default(now())

  round SecAggRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, tenantId])
  @@index([roundId])
}

model SecAggMaskedUpdate {
  id            String   @id @default(cuid())
  roundId       String
  tenantId      String
  maskedValue   Float
  personalMask  Float
  createdAt     DateTime @default(now())

  round SecAggRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, tenantId])
  @@index([roundId])
}

/// Cross-tenant federated aggregates (anonymized).
model GlobalInsight {
  id           String   @id @default(cuid())
  category     String
  metric       String
  value        Float
  sampleSize   Int
  tenantCount  Int
  noiseEpsilon Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([category, metric])
  @@index([category])
}

/// Anonymized cross-tenant agent execution patterns (no PII, no transcripts).
model GlobalAgentPattern {
  id             String   @id @default(cuid())
  category       String
  agentKey       String
  patternType    String
  payloadJson    Json
  tenantCount    Int      @default(0)
  kAnonymityMet  Boolean  @default(false)
  version        String   @default("1.0.0")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([category, agentKey, patternType])
  @@index([category])
  @@index([agentKey])
}

/// Per-tenant global knowledge sync audit log.
model GlobalKnowledgeSyncLog {
  id             String   @id @default(cuid())
  tenantId       String
  catalogVersion String
  appliedCount   Int
  retiredCount   Int      @default(0)
  profile        String
  syncedAt       DateTime @default(now())

  @@index([tenantId, syncedAt])
}

/// A/B experiment for update profiles / patch sets.
model GlobalKnowledgeExperiment {
  id           String    @id @default(cuid())
  name         String
  profileArm   String
  patchSetKeys Json?
  bucketMin    Int       @default(0)
  bucketMax    Int       @default(49)
  startAt      DateTime  @default(now())
  endAt        DateTime?
  status       String    @default("running")
  createdAt    DateTime  @default(now())

  outcomes GlobalKnowledgeExperimentOutcome[]
}

model GlobalKnowledgeExperimentOutcome {
  id           String   @id @default(cuid())
  experimentId String
  tenantId     String
  metric       String
  value        Float
  recordedAt   DateTime @default(now())

  experiment GlobalKnowledgeExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, tenantId])
}
