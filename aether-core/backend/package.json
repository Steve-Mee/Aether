{
  "name": "aether-backend",
  "version": "0.8.1",
  "description": "AETHER Core Backend",
  "engines": {
    "node": ">=20 <21"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "peer-worker": "ts-node-dev --respawn --transpile-only src/peerWorker.ts",
    "federated-worker": "ts-node-dev --respawn --transpile-only src/federatedWorker.ts",
    "build": "tsc",
    "sentry:sourcemaps": "sentry-cli sourcemaps upload --org \"$SENTRY_ORG\" --project \"${SENTRY_BACKEND_PROJECT:-$SENTRY_PROJECT}\" --release \"$APP_VERSION\" ./dist",
    "start": "node dist/index.js",
    "test": "jest",
    "test:ci": "jest --ci --coverage --passWithNoTests=false",
    "validate:dod": "node ../scripts/validate-dod.js",
    "pilot:metrics": "node ../scripts/pilot-metrics-check.js",
    "pilot:snapshot": "node ../scripts/record-pilot-snapshot.js",
    "pilot:seed-demo": "ts-node prisma/seed-pilot-mail-demo.ts",
    "lint": "tsc --noEmit",
    "verify:ci": "npm run lint && npm run test:ci",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:validate": "prisma validate",
    "brain:reembed": "ts-node scripts/reembed-brain-memory.ts",
    "brain:verify-schema": "ts-node scripts/verify-brain-schema.ts",
    "setup:env": "node ../scripts/generate-env.js",
    "setup": "npm run setup:env && npm run prisma:generate"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@langchain/core": "^0.3.26",
    "@langchain/langgraph": "^0.2.36",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.57.0",
    "@types/pdfkit": "^0.17.6",
    "argon2": "^0.44.0",
    "axios": "^1.18.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "imap": "^0.8.17",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "mailparser": "^3.9.12",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "prisma": "^7.8.0",
    "stripe": "^17.7.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "playwright": "^1.44.0",
    "redis": "^4.6.13"
  },
  "devDependencies": {
    "@sentry/cli": "^2.58.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/imap": "^0.8.10",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
