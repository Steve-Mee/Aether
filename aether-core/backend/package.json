{
  "name": "aether-backend",
  "version": "0.8.1",
  "description": "AETHER Core Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:ci": "jest --ci --coverage --passWithNoTests=false",
    "validate:dod": "node ../scripts/validate-dod.js",
    "pilot:metrics": "node ../scripts/pilot-metrics-check.js",
    "pilot:snapshot": "node ../scripts/record-pilot-snapshot.js",
    "pilot:seed-demo": "ts-node prisma/seed-pilot-mail-demo.ts",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:validate": "prisma validate",
    "setup:env": "node ../scripts/generate-env.js",
    "setup": "npm run setup:env && npm run prisma:generate"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "imap": "^0.8.17",
    "mailparser": "^3.6.7",
    "nodemailer": "^6.9.13",
    "prisma": "^5.22.0",
    "stripe": "^17.7.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "playwright": "^1.44.0",
    "redis": "^4.6.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/imap": "^0.8.10",
    "@types/jest": "^29.5.12",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
