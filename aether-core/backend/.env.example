# Host port 15432 when using `docker compose up postgres` (avoids native Windows Postgres on 5432/5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/aether_core?schema=public"
PORT=9000
NODE_ENV=development
OLLAMA_BASE_URL=http://localhost:11434

# Auth (generate via npm run setup:env)
AETHER_API_KEY=
AETHER_DEFAULT_TENANT=tenant_default
# JWT merchant login (required when VITE_AUTH_PROVIDER=jwt; min 16 chars)
AETHER_JWT_SECRET=
AETHER_JWT_EXPIRES_IN=15m
AETHER_REFRESH_EXPIRES_IN=7d
AETHER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AETHER_SEED_USER_PASSWORD=AetherDev2026!

# Mail — IMAP ingest + SMTP outbound
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_PORT=993
IMAP_POLL_INTERVAL_MS=60000
IMAP_TLS_REJECT_UNAUTHORIZED=true
IMAP_MAX_BATCH=25
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_FROM=
SMTP_SEND=false

# Supplier intelligence
SUPPLIER_SCRAPER=http
SUPPLIER_MONITOR_ENABLED=false
SUPPLIER_MONITOR_INTERVAL_MS=3600000
SUPPLIER_ALLOWLIST=
SUPPLIER_WORKER_URL=http://localhost:8090
SUPPLIER_WORKER_TIMEOUT_MS=120000

# Payments
PAYMENT_PROVIDER=local
STRIPE_SECRET_KEY=
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_CONNECT_ONBOARD_URL=
STRIPE_WEBHOOK_SECRET=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=

# Webhooks (required for supplier/payment webhook routes in production)
SUPPLIER_WEBHOOK_SECRET=

# Observability & rate limiting
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# Sentry (staging/production — disabled in development unless SENTRY_DEV=true)
SENTRY_DSN=
SENTRY_ENV=staging
SENTRY_DEV=false
# OBSERVABILITY_PROBE_ENABLED=true  # Allow POST /api/admin/observability/probe-error outside staging
APP_VERSION=0.8.1
REDIS_URL=
RATE_LIMIT_MAX=120
EVENT_BUS_URL=

# Feature flags (override TenantFeature DB)
FEATURE_AGENTIC=true
FEATURE_PREDICTIVE=false
FEATURE_SELF_EVOLVING=false
FEATURE_PHYSICAL=false
FEATURE_CO_OWNERSHIP=false

# Hive Mind
HIVE_MIND_SALT=
HIVE_FEDERATED_JOB_ENABLED=true
HIVE_FEDERATED_INTERVAL_MS=3600000
HIVE_DP_EPSILON=1.0

# Agentic commerce risk caps
NEGOTIATION_MAX_DISCOUNT_PCT=20
NEGOTIATION_MAX_ROUNDS=5

# Merchant notifications (approval backlog)
MERCHANT_NOTIFICATIONS_ENABLED=false
MERCHANT_WEBHOOK_URL=

# Ecosystem jobs (federated hive) — enable only after core reliability gates pass
ECOSYSTEM_JOBS_ENABLED=false

# Test harness only — never set in production
AETHER_TEST_AUTH_BYPASS=false

# Webhook tenant binding
SUPPLIER_WEBHOOK_TENANT=tenant_default
PAYMENT_WEBHOOK_TENANT=tenant_default
STRIPE_WEBHOOK_TENANT=tenant_default

PHYSICAL_ADAPTER=mock
PHYSICAL_DEVICE_URL=

# Billing & anti-abuse
AETHER_SUCCESS_FEE_RATE=0.12
CO_OWNERSHIP_MAX_SHARES_PER_DAY=10
MARKETPLACE_MAX_LISTINGS=50
