# Host port 15432 when using `docker compose up postgres` (avoids native Windows Postgres on 5432/5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/aether_core?schema=public"
PORT=9000
NODE_ENV=development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Intelligence layer (PersonalBrain / pgvector)
# INTELLIGENCE_EMBEDDING=hash|ollama (default hash locally; docker-compose sets ollama)
# INTELLIGENCE_VECTOR_BACKEND=pgvector|memory|lancedb (lancedb = portable JSON file store)
# INTELLIGENCE_KNOWLEDGE_TRANSFER_ENABLED=false
# LANCE_DB_PATH=./data/brain-lance

# Command brain multi-step agent
COMMAND_BRAIN_STREAMING_ENABLED=true
# COMMAND_BRAIN_PLANNING_ENABLED=true
# COMMAND_BRAIN_PLAN_MEMORY_ENABLED=true
# COMMAND_BRAIN_REFLECTION_ENABLED=true
# COMMAND_BRAIN_DYNAMIC_REPLAN_ENABLED=true
# COMMAND_BRAIN_COMPOUND_ENABLED=true

# Auth (generate via npm run setup:env)
AETHER_API_KEY=
AETHER_DEFAULT_TENANT=tenant_default
# JWT merchant login (required when VITE_AUTH_PROVIDER=jwt; min 16 chars)
AETHER_JWT_SECRET=
AETHER_JWT_EXPIRES_IN=15m
AETHER_REFRESH_EXPIRES_IN=7d
AETHER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AETHER_SEED_USER_PASSWORD=AetherDev2026!

# Mail — IMAP ingest + SMTP outbound
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_PORT=993
IMAP_POLL_INTERVAL_MS=60000
IMAP_TLS_REJECT_UNAUTHORIZED=true
IMAP_MAX_BATCH=25
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_FROM=
SMTP_SEND=false

# Supplier intelligence
SUPPLIER_SCRAPER=http
SUPPLIER_MONITOR_ENABLED=false
SUPPLIER_MONITOR_INTERVAL_MS=3600000
SUPPLIER_ALLOWLIST=
SUPPLIER_WORKER_URL=http://localhost:8090
SUPPLIER_WORKER_TIMEOUT_MS=120000

# Payments
PAYMENT_PROVIDER=local
STRIPE_SECRET_KEY=
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_CONNECT_ONBOARD_URL=
STRIPE_WEBHOOK_SECRET=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=

# Webhooks (required for supplier/payment webhook routes in production)
SUPPLIER_WEBHOOK_SECRET=

# Observability & rate limiting
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# Sentry (staging/production — disabled in development unless SENTRY_DEV=true)
SENTRY_DSN=
SENTRY_ENV=staging
SENTRY_DEV=false
# OBSERVABILITY_PROBE_ENABLED=true  # Allow POST /api/admin/observability/probe-error outside staging
APP_VERSION=0.8.1
REDIS_URL=
RATE_LIMIT_MAX=120
# Hybrid Redis failsafe: spill spillable/hot keys to Postgres when RAM pressure rises.
# Soft (default 0.75): demote aether:runmem:* after durable upsert. Hard (0.90): spill rl:* counters.
# Requires maxmemory configured on Redis; unlimited maxmemory → governor no-ops.
REDIS_SPILL_ENABLED=true
REDIS_MEMORY_SOFT_RATIO=0.75
REDIS_MEMORY_HARD_RATIO=0.90
REDIS_MEMORY_GOVERNOR_MS=30000
EVENT_BUS_URL=

# Feature flags (override TenantFeature DB)
FEATURE_AGENTIC=true
FEATURE_PREDICTIVE=false
FEATURE_SELF_EVOLVING=false
FEATURE_PHYSICAL=false
FEATURE_CO_OWNERSHIP=false
# Storefront Builder + public API (Appendix C / G — defaults OFF)
# Primary gates (featureGate): FEATURE_* ; aliases map to the same flag in isFeatureEnabled
FEATURE_STOREFRONT_BUILDER=false
STOREFRONT_BUILDER_ENABLED=false
FEATURE_STOREFRONT_PUBLIC_API=false
STOREFRONT_PUBLIC_API_ENABLED=false
# Local artifact root for compiled revisions + live pointers
STOREFRONT_ARTIFACTS_DIR=tmp/storefront-artifacts
# storefront-runtime preview listen port (LOCKED 4177). Preview URLs:
#   http://localhost:<STOREFRONT_PREVIEW_PORT>/preview/:revisionId?token=<signed>
STOREFRONT_PREVIEW_PORT=4177
# Preview token HMAC (required outside test for Authorization: Preview <token>)
STOREFRONT_PREVIEW_HMAC_SECRET=
# Public storefront IP rate limit (Redis rl:sf:* when REDIS_URL set; memory/spill fallback) — 60/min Birth lock
STOREFRONT_PUBLIC_RATE_LIMIT_MAX=60
# Product media uploads (LocalDiskMediaStore); default ./data/media
# MEDIA_UPLOAD_DIR=
# Local deploy: writes live/{tenantId}/{projectId}/revision.json under artifacts.
# false/unset = staged=true (pointer still written); true = staged=false.
# STOREFRONT_DEPLOY_PROVIDER: stub | local-edge (default when deploy enabled) | cloudflare
# Even when false, deploy adapters still set liveRevisionId + status=live locally.
STOREFRONT_DEPLOY_ENABLED=false
STOREFRONT_DEPLOY_PROVIDER=
STOREFRONT_EDGE_ROOT=tmp/storefront-edge
STOREFRONT_EDGE_PUBLIC_BASE=http://localhost:4177/edge
# Cloudflare R2 (only when STOREFRONT_DEPLOY_PROVIDER=cloudflare) — fail-closed without these
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_R2_BUCKET=
# CF_R2_PUBLIC_BASE=
# Storefront organism (dead-man heal + build-wall trigger). Opt out with =false.
# Heal: live sites missing artifacts → rebuild in place, else demote to preview (never auto-publish).
# Wall: N consecutive failed builds → website.build.wall_triggered + STORE_ITERATE suggestion + one Appendix-H revision rebuild.
STOREFRONT_ORGANISM_ENABLED=true
STOREFRONT_BUILD_WALL_FAILURES=3
STOREFRONT_ORGANISM_INTERVAL_MS=60000

# Hive Mind
HIVE_MIND_SALT=
HIVE_FEDERATED_JOB_ENABLED=true
HIVE_FEDERATED_INTERVAL_MS=3600000
HIVE_DP_EPSILON=1.0

# Agentic commerce risk caps
NEGOTIATION_MAX_DISCOUNT_PCT=20
NEGOTIATION_MAX_ROUNDS=5

# Merchant notifications (approval backlog)
MERCHANT_NOTIFICATIONS_ENABLED=false
MERCHANT_WEBHOOK_URL=

# Ecosystem jobs (federated hive) — enable only after core reliability gates pass
ECOSYSTEM_JOBS_ENABLED=false

# Phase 5 — multi-agent delegation & reflection platform
MULTI_AGENT_DELEGATION_ENABLED=true
# MULTI_AGENT_LLM_ROUTING=false
# Dev default-on; prod requires MULTI_AGENT_LLM_COLLABORATION_PLANNING=true
# MULTI_AGENT_LLM_COLLABORATION_PLANNING=false
# MULTI_AGENT_RESULT_SYNTHESIS=false
# MULTI_AGENT_MAX_PARALLEL_AGENTS=3
# MULTI_AGENT_ADAPTIVE_ROUTING=false
# MULTI_AGENT_NESTED_PLANS=false
# MULTI_AGENT_DIRECT_PEER=false
MULTI_AGENT_PEER_DELEGATION=true
# MULTI_AGENT_SUPPLIER_PEER=true
# MULTI_AGENT_INVENTORY_PEER=true
# INVENTORY_LOW_STOCK_MONITOR_ENABLED=false
# INVENTORY_LOW_STOCK_MONITOR_INTERVAL_MS=3600000

# Proactive AETHER Brain (merchant-facing suggestions; opt-in per tenant via proactivePrefs)
# Proactive Brain (v1 + v2 feature flags — prod-safe default off)
# PROACTIVE_BRAIN_ENABLED=false
# PROACTIVE_BRAIN_INTERVAL_MS=3600000

# Long-term merchant goals (disabled in prod until explicitly enabled)
# GOALS_ENABLED=false
# GOAL_OUTCOME_ATTRIBUTION_ENABLED=false
# GOAL_AI_SUGGESTIONS_ENABLED=false
# GOAL_MULTI_OPTIMIZATION_ENABLED=false
# GOAL_PLANNING_GRAPH_ENABLED=false
# GOAL_FEDERATED_PATTERNS_ENABLED=false
# GOAL_PROGRESS_INTERVAL_MS=21600000
# PROACTIVE_CROSS_DEDUPE_ENABLED=false
# PROACTIVE_SSE_ENABLED=false
# OVERVIEW_SSE_ENABLED=false
# OVERVIEW_FEED_READ_LEGACY=false
# OVERVIEW_FEED_BACKFILL=false
# OVERVIEW_EMAIL_NOTIFICATIONS_ENABLED=false
# OVERVIEW_EMAIL_MAX_PER_HOUR=20
# PROACTIVE_LEARNING_ENABLED=false
# PROACTIVE_LLM_ENRICHMENT_ENABLED=false
# PROACTIVE_AUTO_EXECUTE_ENABLED=false
# PROACTIVE_ENRICHMENT_MAX_PER_HOUR=3
# PROACTIVE_AUTO_EXECUTE_COOLDOWN_MS=14400000
# PROACTIVE_EMAIL_NOTIFICATIONS_ENABLED=false
# PROACTIVE_EMAIL_MAX_PER_HOUR=1
# PROACTIVE_GLOBAL_PATTERNS_ENABLED=false
# PROACTIVE_DETECTION_ORCHESTRATION_ENABLED=false
# PROACTIVE_DETECTION_UNIFY_PEER=false
# PROACTIVE_DETECTION_ORCH_MAX_PER_HOUR=2
# MULTI_AGENT_ALLOWED_TARGETS=mail,supplier,pricing,inventory,customer,forecast,approvals,outcomes,negotiation,catalog,autonomy,admin
# MULTI_AGENT_PEER_MAX_DEPTH=2
# MULTI_AGENT_ASYNC_PEER=false
# MULTI_AGENT_ASYNC_PEER_POLL_MS=2000
# MULTI_AGENT_GRAPH_ORCHESTRATION=false
# MULTI_AGENT_GRAPH_PEER_EDGES=false
# brainCrossTenantAgentPatternsEnabled — global-advisory peer uses AgentPatternSync gate
# PERSONAL_BRAIN_REFLECTION_DISTILLATION_ENABLED=true
# INTELLIGENCE_DISTILLATION_LLM=true

# Phase 9 — Kafka relay, federated sandbox, LangGraph, autonomy peer
# KAFKA_ENABLED=false
# KAFKA_BROKERS=localhost:9092
# EVENT_BUS_MODE=inprocess
# OUTBOX_RELAY_POLL_MS=1000
# MULTI_AGENT_GRAPH_BACKEND=native
# MULTI_AGENT_GRAPH_CHECKPOINT=false
# BRAIN_FEDERATED_EXECUTION_ENABLED=false
# AGENT_PATTERN_CONTRIBUTION_JOB_ENABLED=false
# AGENT_PATTERN_CONTRIBUTION_INTERVAL_MS=3600000
# MULTI_AGENT_MAIL_PEER=false
MULTI_AGENT_SUPPLIER_PEER=true

# Phase 10 — federated v2 RPC, broker config, expanded autonomy peer
# MESSAGE_BROKER=none
# FEDERATED_RPC_ENABLED=false
# FEDERATED_DEPLOYMENT_ID=local
# FEDERATED_DEPLOYMENTS_JSON=
# FEDERATED_SIGNING_SECRET=
# FEDERATED_RPC_TIMEOUT_MS=30000

# Phase 11 — Kafka hardening, bilateral exchange, registry UI
# OUTBOX_RELAY_OWNER=api
# KAFKA_SSL_ENABLED=false
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# BRAIN_BILATERAL_EXCHANGE_ENABLED=false
# MULTI_AGENT_PHYSICAL_PEER=false
# MULTI_AGENT_NEGOTIATION_PEER=false
# MULTI_AGENT_INVENTORY_PEER=false
MULTI_AGENT_INVENTORY_PEER=true
# MULTI_AGENT_AUTONOMY_PEER=false

# Phase 12 — run memory, notify-only peer, promotion agent, supervisor mode, negotiation auto-loop
# MULTI_AGENT_RUN_MEMORY=false
# MULTI_AGENT_RUN_MEMORY_CACHE_TTL_MS=2000
# MULTI_AGENT_MERCHANT_MEMORY=false
# MULTI_AGENT_MERCHANT_MEMORY_PROMOTE=true
# MULTI_AGENT_MERCHANT_MEMORY_DUAL_WRITE=false
# RUN_MEMORY_GC_ENABLED=false
# RUN_MEMORY_GC_INTERVAL_MS=3600000
# RUN_MEMORY_RUN_TTL_MS=86400000
# MERCHANT_MEMORY_TTL_MS=604800000
# RUN_MEMORY_MAX_AGE_MS=2592000000
# RUN_MEMORY_REDIS_CACHE=false
# RUN_MEMORY_REDIS_TTL_SEC=30
# MULTI_AGENT_NOTIFY_PEER=false
# MULTI_AGENT_PROMOTION_PEER=false
# Dev default-on; prod requires MULTI_AGENT_SUPERVISOR_MODE=true
# MULTI_AGENT_SUPERVISOR_MODE=false
# MULTI_AGENT_NEGOTIATION_AUTO_LOOP=false

# Test harness only — never set in production
AETHER_TEST_AUTH_BYPASS=false

# Webhook tenant binding
SUPPLIER_WEBHOOK_TENANT=tenant_default
PAYMENT_WEBHOOK_TENANT=tenant_default
STRIPE_WEBHOOK_TENANT=tenant_default

PHYSICAL_ADAPTER=mock
PHYSICAL_DEVICE_URL=

# Notification system (Phase 2)
# NOTIFICATION_MATERIALIZE_ENABLED=true
# NOTIFICATION_VIRTUAL_INBOX_FALLBACK=false
# NOTIFICATION_SSE_ENABLED=true
# WEB_PUSH_ENABLED=false
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:support@aether.local

# Billing & anti-abuse
AETHER_SUCCESS_FEE_RATE=0.12
CO_OWNERSHIP_MAX_SHARES_PER_DAY=10
MARKETPLACE_MAX_LISTINGS=50
