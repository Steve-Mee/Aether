# Host port 15432 when using `docker compose up postgres` (avoids native Windows Postgres on 5432/5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/aether_core?schema=public"
PORT=9000
NODE_ENV=development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Intelligence layer (PersonalBrain / pgvector)
# INTELLIGENCE_EMBEDDING=hash|ollama (default hash locally; docker-compose sets ollama)
# INTELLIGENCE_VECTOR_BACKEND=pgvector|memory|lancedb (lancedb = portable JSON file store)
# INTELLIGENCE_KNOWLEDGE_TRANSFER_ENABLED=false
# LANCE_DB_PATH=./data/brain-lance

# Command brain multi-step agent
COMMAND_BRAIN_STREAMING_ENABLED=true
# COMMAND_BRAIN_PLANNING_ENABLED=true
# COMMAND_BRAIN_PLAN_MEMORY_ENABLED=true
# COMMAND_BRAIN_REFLECTION_ENABLED=true
# COMMAND_BRAIN_DYNAMIC_REPLAN_ENABLED=true
# COMMAND_BRAIN_COMPOUND_ENABLED=true

# Auth (generate via npm run setup:env)
AETHER_API_KEY=
AETHER_DEFAULT_TENANT=tenant_default
# JWT merchant login (required when VITE_AUTH_PROVIDER=jwt; min 16 chars)
AETHER_JWT_SECRET=
AETHER_JWT_EXPIRES_IN=15m
AETHER_REFRESH_EXPIRES_IN=7d
AETHER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AETHER_SEED_USER_PASSWORD=AetherDev2026!

# Mail — IMAP ingest + SMTP outbound
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_PORT=993
IMAP_POLL_INTERVAL_MS=60000
IMAP_TLS_REJECT_UNAUTHORIZED=true
IMAP_MAX_BATCH=25
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_FROM=
SMTP_SEND=false

# Supplier intelligence
SUPPLIER_SCRAPER=http
SUPPLIER_MONITOR_ENABLED=false
SUPPLIER_MONITOR_INTERVAL_MS=3600000
SUPPLIER_ALLOWLIST=
SUPPLIER_WORKER_URL=http://localhost:8090
SUPPLIER_WORKER_TIMEOUT_MS=120000

# Payments
PAYMENT_PROVIDER=local
STRIPE_SECRET_KEY=
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_CONNECT_ONBOARD_URL=
STRIPE_WEBHOOK_SECRET=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=

# Webhooks (required for supplier/payment webhook routes in production)
SUPPLIER_WEBHOOK_SECRET=

# Observability & rate limiting
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# Sentry (staging/production — disabled in development unless SENTRY_DEV=true)
SENTRY_DSN=
SENTRY_ENV=staging
SENTRY_DEV=false
# OBSERVABILITY_PROBE_ENABLED=true  # Allow POST /api/admin/observability/probe-error outside staging
APP_VERSION=0.8.1
REDIS_URL=
RATE_LIMIT_MAX=120
EVENT_BUS_URL=

# Feature flags (override TenantFeature DB)
FEATURE_AGENTIC=true
FEATURE_PREDICTIVE=false
FEATURE_SELF_EVOLVING=false
FEATURE_PHYSICAL=false
FEATURE_CO_OWNERSHIP=false

# Hive Mind
HIVE_MIND_SALT=
HIVE_FEDERATED_JOB_ENABLED=true
HIVE_FEDERATED_INTERVAL_MS=3600000
HIVE_DP_EPSILON=1.0

# Agentic commerce risk caps
NEGOTIATION_MAX_DISCOUNT_PCT=20
NEGOTIATION_MAX_ROUNDS=5

# Merchant notifications (approval backlog)
MERCHANT_NOTIFICATIONS_ENABLED=false
MERCHANT_WEBHOOK_URL=

# Ecosystem jobs (federated hive) — enable only after core reliability gates pass
ECOSYSTEM_JOBS_ENABLED=false

# Phase 5 — multi-agent delegation & reflection platform
MULTI_AGENT_DELEGATION_ENABLED=true
# MULTI_AGENT_LLM_ROUTING=false
# Dev default-on; prod requires MULTI_AGENT_LLM_COLLABORATION_PLANNING=true
# MULTI_AGENT_LLM_COLLABORATION_PLANNING=false
# MULTI_AGENT_RESULT_SYNTHESIS=false
# MULTI_AGENT_MAX_PARALLEL_AGENTS=3
# MULTI_AGENT_ADAPTIVE_ROUTING=false
# MULTI_AGENT_NESTED_PLANS=false
# MULTI_AGENT_DIRECT_PEER=false
MULTI_AGENT_PEER_DELEGATION=true
# MULTI_AGENT_ALLOWED_TARGETS=mail,supplier,pricing,inventory,customer,forecast,approvals,outcomes,negotiation,catalog,autonomy,admin
# MULTI_AGENT_PEER_MAX_DEPTH=2
# MULTI_AGENT_ASYNC_PEER=false
# MULTI_AGENT_ASYNC_PEER_POLL_MS=2000
# MULTI_AGENT_GRAPH_ORCHESTRATION=false
# MULTI_AGENT_GRAPH_PEER_EDGES=false
# brainCrossTenantAgentPatternsEnabled — global-advisory peer uses AgentPatternSync gate
# PERSONAL_BRAIN_REFLECTION_DISTILLATION_ENABLED=true
# INTELLIGENCE_DISTILLATION_LLM=true

# Phase 9 — Kafka relay, federated sandbox, LangGraph, autonomy peer
# KAFKA_ENABLED=false
# KAFKA_BROKERS=localhost:9092
# EVENT_BUS_MODE=inprocess
# OUTBOX_RELAY_POLL_MS=1000
# MULTI_AGENT_GRAPH_BACKEND=native
# MULTI_AGENT_GRAPH_CHECKPOINT=false
# BRAIN_FEDERATED_EXECUTION_ENABLED=false
# AGENT_PATTERN_CONTRIBUTION_JOB_ENABLED=false
# AGENT_PATTERN_CONTRIBUTION_INTERVAL_MS=3600000
# MULTI_AGENT_MAIL_PEER=false
# MULTI_AGENT_SUPPLIER_PEER=false

# Phase 10 — federated v2 RPC, broker config, expanded autonomy peer
# MESSAGE_BROKER=none
# FEDERATED_RPC_ENABLED=false
# FEDERATED_DEPLOYMENT_ID=local
# FEDERATED_DEPLOYMENTS_JSON=
# FEDERATED_SIGNING_SECRET=
# FEDERATED_RPC_TIMEOUT_MS=30000

# Phase 11 — Kafka hardening, bilateral exchange, registry UI
# OUTBOX_RELAY_OWNER=api
# KAFKA_SSL_ENABLED=false
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# BRAIN_BILATERAL_EXCHANGE_ENABLED=false
# MULTI_AGENT_PHYSICAL_PEER=false
# MULTI_AGENT_NEGOTIATION_PEER=false
# MULTI_AGENT_INVENTORY_PEER=false
# MULTI_AGENT_AUTONOMY_PEER=false

# Test harness only — never set in production
AETHER_TEST_AUTH_BYPASS=false

# Webhook tenant binding
SUPPLIER_WEBHOOK_TENANT=tenant_default
PAYMENT_WEBHOOK_TENANT=tenant_default
STRIPE_WEBHOOK_TENANT=tenant_default

PHYSICAL_ADAPTER=mock
PHYSICAL_DEVICE_URL=

# Billing & anti-abuse
AETHER_SUCCESS_FEE_RATE=0.12
CO_OWNERSHIP_MAX_SHARES_PER_DAY=10
MARKETPLACE_MAX_LISTINGS=50
