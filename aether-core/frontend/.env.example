# AETHER Frontend environment variables
#
# Vite loads env from the PARENT directory (aether-core/), not this folder.
# Copy aether-core/.env.example to aether-core/.env and configure there.
#
# Quick reference — see docs/API_INTEGRATION.md for full guide.
#
# VITE_API_URL=                    # API base (empty = dev proxy to localhost:9000)
# VITE_API_BASE_URL=               # Alias, takes precedence over VITE_API_URL
# VITE_USE_MOCK=true               # Offline mode (overrides VITE_DATA_SOURCE)
# VITE_DATA_SOURCE=mock|live       # mock = mockAdapter, live = httpAdapter
# VITE_AETHER_API_KEY=             # Must match backend AETHER_API_KEY
# VITE_AETHER_TENANT=              # Default tenant header
# VITE_HYBRID_DEMO=true|false      # Pad thin API with demo data in live mode
# VITE_LIVE_DEMO=true              # Opt-in: simulated notifications in live mode (default off)
# VITE_SUPPLIERS_DEMO=true|false   # Force demo suppliers when API empty
# VITE_AUTH_PROVIDER=stub|jwt
# VITE_SENTRY_DSN=                 # Enable Sentry (staging/production)
# VITE_SENTRY_ENV=                 # Sentry environment tag (staging|production)
# VITE_APP_VERSION=                # Release version for Sentry
# VITE_SENTRY_DEV=true             # Optional: Sentry in local dev
# VITE_SENTRY_REPLAY_ENABLED=true  # Enable replay in staging (auto on in production)
# VITE_SENTRY_REPLAY_SESSION_RATE=0
# VITE_SENTRY_REPLAY_ERROR_RATE=0.1
# SENTRY_AUTH_TOKEN=               # CI only — sourcemap upload
# SENTRY_ORG=                      # CI only
# SENTRY_PROJECT=                  # CI only
