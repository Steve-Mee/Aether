{
  "name": "aether-admin",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "verify:copy": "node scripts/verify-ui-copy.mjs",
    "verify:ui": "npm run verify:copy && npm run build",
    "verify:ci": "npm run lint && npm run lint:eslint && npm run format:check && npm test && npm run verify:copy && npm run build && npm run size:check && npm run build:staging && npm run audit:ci",
    "verify:ci:e2e": "npm run verify:ci && npm run test:flows && npm run test:visual && npm run test:a11y && npm run lint:a11y",
    "size:check": "size-limit",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint src",
    "lint:a11y": "eslint src --max-warnings 9999",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "audit:ci": "node scripts/audit-ci.mjs",
    "audit:ci:dev": "npm audit --audit-level=moderate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:flows": "playwright test --config=playwright.flow.config.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/react": "^10.57.0",
    "@tanstack/react-query": "^5.62.0",
    "@xyflow/react": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.2"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.44.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@size-limit/file": "^11.2.0",
    "@tanstack/react-query-devtools": "^5.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "postcss": "^8.5.25",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^11.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vitest": "^2.1.0"
  }
}
